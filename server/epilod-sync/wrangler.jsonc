{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "epilod-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDO"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "RL",
      "namespace_id": "4821",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO"]
    }
  ]
}
