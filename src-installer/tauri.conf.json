{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Epilod Party Setup",
  "version": "0.1.5",
  "identifier": "com.epilod.party.setup",
  "build": {
    "beforeDevCommand": "npm run installer:dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run installer:build",
    "frontendDist": "../installer/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Epilod Party Setup",
        "width": 460,
        "height": 344,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../src-tauri/icons/32x32.png",
      "../src-tauri/icons/128x128.png",
      "../src-tauri/icons/128x128@2x.png",
      "../src-tauri/icons/icon.ico"
    ],
    "resources": [
      "resources/payload/*"
    ]
  }
}
